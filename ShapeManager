package com.mycompany.mavenproject1;

import javafx.scene.canvas.GraphicsContext;

/**
 * This class the drawing of basic geometric shapes on a canvas.
 *
 * SM uses a GraphicsContext to draw rectangles, squares, ellipses,
 * circles, triangles, and regular polygons.
 */
public class ShapeManager {

    private GraphicsContext gc;

    /**
     * Creates a ShapeManager using the provided GraphicsContext.
     *
     * @param gc the GraphicsContext used to draw the shapes
     */
    public ShapeManager(GraphicsContext gc) {
        this.gc = gc;
    }

    public void drawRectangle(double x, double y, double width, double height) {
        gc.strokeRect(x, y, width, height);
    }

    public void drawSquare(double x, double y, double size) {
        gc.strokeRect(x, y, size, size);
    }

    public void drawEllipse(double x, double y, double width, double height) {
        gc.strokeOval(x, y, width, height);
    }

    public void drawCircle(double x, double y, double diameter) {
        gc.strokeOval(x, y, diameter, diameter);
    }

    public void drawTriangle(double startX, double startY, double endX, double endY) {
        double[] xPoints = {startX, endX, (startX + endX) / 2};
        double[] yPoints = {endY, endY, startY};
        gc.strokePolygon(xPoints, yPoints, 3);
    }

    public void drawRightTriangle(double startX, double startY, double endX, double endY) {
        double[] xPoints = {startX, startX, endX};
        double[] yPoints = {startY, endY, endY};
        gc.strokePolygon(xPoints, yPoints, 3);
    }

    public void drawPolygon(
            double centerX,
            double centerY,
            double radius,
            int sides
    ) {
        if (sides < 3 || radius <= 0) {
            return;
        }

        double[] xPoints = new double[sides];
        double[] yPoints = new double[sides];

        for (int i = 0; i < sides; i++) {
            double angle =
                    2 * Math.PI * i / sides - Math.PI / 2;

            xPoints[i] =
                    centerX + radius * Math.cos(angle);

            yPoints[i] =
                    centerY + radius * Math.sin(angle);
        }

        gc.strokePolygon(xPoints, yPoints, sides);
    }

    /**
     * This draws a star with the specified number of points.
     *
     * @param centerX the x-coordinate of the star's center
     * @param centerY the y-coordinate of the star's center
     * @param outerRadius the distance from the center to an outer point
     * @param points the number of star points
     */
    public void drawStar(
            double centerX,
            double centerY,
            double outerRadius,
            int points
    ) {
        if (points < 2 || outerRadius <= 0) {
            return;
        }

        int vertices = points * 2;

        double[] xPoints = new double[vertices];
        double[] yPoints = new double[vertices];

        double innerRadius = outerRadius * 0.45;

        for (int i = 0; i < vertices; i++) {
            double angle =
                    Math.PI * i / points - Math.PI / 2;

            double radius = (i % 2 == 0)
                    ? outerRadius
                    : innerRadius;

            xPoints[i] =
                    centerX + radius * Math.cos(angle);

            yPoints[i] =
                    centerY + radius * Math.sin(angle);
        }

        gc.strokePolygon(xPoints, yPoints, vertices);
    }
}
