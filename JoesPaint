    private void drawSelection(
        GraphicsContext gc,
        double startX,
        double startY,
        double endX,
        double endY
) {
    double x = Math.min(startX, endX);
    double y = Math.min(startY, endY);

    double width = Math.abs(endX - startX);
    double height = Math.abs(endY - startY);

    gc.setLineDashes(5);
    gc.strokeRect(x, y, width, height);
    gc.setLineDashes(0);
    }
    private WritableImage copySelection(
        StackPane drawingArea,
        Canvas selectionOverlay,
        double startX,
        double startY,
        double endX,
        double endY
) {
    double x = Math.min(startX, endX);
    double y = Math.min(startY, endY);

    double width = Math.abs(endX - startX);
    double height = Math.abs(endY - startY);

    if (width <= 0 || height <= 0) {
        return null;
    }

    selectionOverlay.setVisible(false);

    SnapshotParameters params = new SnapshotParameters();

    params.setViewport(
        new Rectangle2D(
            x,
            y,
            width,
            height
        )
    );

    WritableImage image = new WritableImage(
        (int) Math.ceil(width),
        (int) Math.ceil(height)
    );

    drawingArea.snapshot(
        params,
        image
    );

    selectionOverlay.setVisible(true);

    return image;
}

/**
 * this shows a warning when saving in a format other than PNG.
 * JPG can reduce image quality and does not preserve transparency;
 * BMP may also fail to preserve transparency. PNG remains the default.
 *
 * @param format the selected image format
 * @return true if the user chooses to continue saving
 */
private boolean confirmAlternativeFormat(String format) {
    if (format == null || format.equalsIgnoreCase("png")) {
        return true;
    }

    Alert warning = new Alert(Alert.AlertType.CONFIRMATION);
    warning.setTitle("Alternative Format Warning");
    warning.setHeaderText("Some image information may be lost");
    warning.setContentText(
        "You are saving as " + format.toUpperCase() + ".\n\n"
        + "JPG may reduce image quality and does not support transparency. "
        + "Other formats may not preserve every image feature.\n\n"
        + "Do you want to continue saving?"
    );
    warning.getButtonTypes().setAll(ButtonType.YES, ButtonType.NO);

    Optional<ButtonType> result = warning.showAndWait();
    return result.isPresent() && result.get() == ButtonType.YES;
}

