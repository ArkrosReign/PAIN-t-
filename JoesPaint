// layout


/**
 * Main application class for Pain(t).
 *
 * Provides the user interface for opening, editing, drawing on,
 * and saving images.
 */
public class JoesPaint extends Application {

    private boolean unsavedChanges = false;
    private File currentFile;
    private UndoRedoManager undoRedoManager = new UndoRedoManager();
    private FileManager fileManager = new FileManager();
    private AutoSave autoSave;
    private Webserver webserver;

    private Map<Tab, ImageView> tabImageViews = new HashMap<>();
    private Map<Tab, Canvas> tabCanvases = new HashMap<>();
    private Map<Tab, Canvas> tabSelectionOverlays = new HashMap<>();
    private Map<Tab, StackPane> tabDrawingAreas = new HashMap<>();
    private Map<Tab, File> tabFiles = new HashMap<>();

    double startX = 0;
    double startY = 0;
    int polygonSides = 5;
    boolean pencilUndoSaved = false;
    
    double selectionStartX = 0;
    double selectionStartY = 0;
    double selectionEndX = 0;
    double selectionEndY = 0;
    
    Canvas selectionOverlay;
    boolean pasteMode = false;

WritableImage copiedImage = null;
    

    /**
     * starts the application and sets up the
     * menus, drawing tools, image display, saving options,
     * and tabbed workspace.
     *
     * @param stage the main window used by the application
     */
    @Override
    public void start(Stage stage) {

        /**
         * this checks for unsaved changes before closing the application
         * and asks the user if they want to close without saving.
         */
        stage.setOnCloseRequest(e -> { // smart save :p

            if (unsavedChanges) {

                Alert alert = new Alert(Alert.AlertType.CONFIRMATION);
                alert.setTitle("Unsaved Changes");
                alert.setHeaderText("You have unsaved changes.");
                alert.setContentText(
                    "Are you sure you want to close without saving?"
                );

                Optional<ButtonType> result = alert.showAndWait();

                if (result.isPresent() && result.get() == ButtonType.OK) {

                } else {
                    e.consume();
                }
            }
        });

        stage.setOnHidden(e -> {
            if (autoSave != null) {
                autoSave.stop();
            }
        if (webserver != null) {
            webserver.stop();
    }
        });

        // setup for outside the window
        BorderPane root = new BorderPane();

        // basically make the menu then file
        MenuBar menuBar = new MenuBar();
        Menu fileMenu = new Menu("File");

        // menu options
        MenuItem openItem = new MenuItem("Open");
        MenuItem saveItem = new MenuItem("Save");
        MenuItem saveAsItem = new MenuItem("Save As");
        MenuItem undoItem = new MenuItem("Undo");
        MenuItem redoItem = new MenuItem("Redo");
        MenuItem copyItem = new MenuItem("Copy");
        MenuItem pasteItem = new MenuItem("Paste");
        MenuItem clearItem = new MenuItem("Clear");
        MenuItem exitItem = new MenuItem("Exit");

        saveItem.setAccelerator( //for key shortcut, aka save
            new KeyCodeCombination(
                KeyCode.S,
                KeyCombination.SHORTCUT_DOWN
            )
        );

        // help menu
        Menu helpMenu = new Menu("Help");

        MenuItem helpItem = new MenuItem("Help");
        MenuItem aboutItem = new MenuItem("About");

        helpMenu.getItems().addAll(helpItem, aboutItem);

        // add both menus to the menu bar
        menuBar.getMenus().addAll(fileMenu, helpMenu);
        

        /**
         * shows basic instructions for using the application.
         */
        helpItem.setOnAction(e -> {

            Alert alert = new Alert(Alert.AlertType.INFORMATION);
            alert.setTitle("Help");
            alert.setHeaderText("Joes' Pain(t) Help");
            alert.setContentText(
                "Use File > Press Save to save changes.\n"
                + "Use File > Press Save As to save a copy of the image."
            );

            alert.showAndWait();
        });

        /**
         * Displays information about Joes' Pain(t), including
         * the application version and a small developer joke.
         */
        aboutItem.setOnAction(e -> {

            Alert alert = new Alert(Alert.AlertType.INFORMATION);
            alert.setTitle("About");
            alert.setHeaderText("Joes' Pain(t)");
            alert.setContentText(
                "Joes' Pain(t)\n"
                + "Version 1.0\n\n"
                + "A editing application powered by JavaFX. "
                + "Also powered by a caffeine addict"
            );

            alert.showAndWait();
        });

        /**
         * Creates the ImageView used to display the currently opened image.
         */
        ImageView imageView = new ImageView();

        // fix for lines not drawing on a image, SPRINT #2
        imageView.setMouseTransparent(true);

        /**
         * Creates the canvas used for drawing and connects it to
         * the shape and drawing managers.
         */
        Canvas canvas = new Canvas(800, 500);         // drawing canvas       
        selectionOverlay = new Canvas(canvas.getWidth(), canvas.getHeight());
        selectionOverlay.setMouseTransparent(true);       
        GraphicsContext gc = canvas.getGraphicsContext2D();

        ShapeManager shapeManager = new ShapeManager(gc);
        DrawingManager drawingManager = new DrawingManager(gc);

        canvas.setMouseTransparent(false);

        // for the line width slider
        Slider lineWidth = new Slider(1, 20, 5);
        Label lineWidthLabel = new Label("Line Width: 5 px");

        // tool selector
        ComboBox<String> toolSelector = new ComboBox<>();

        toolSelector.getItems().addAll(
            "Line",
            "Rectangle",
            "Select",
            "Pencil",
            "Text",
            "Color Grabber",
            "Square",
            "Ellipse",
            "Circle",
            "Right Triangle",
            "Polygon",
            "Star",
            "Triangle"
        );

        toolSelector.setValue("Line");
        toolSelector.setPrefWidth(120);

        // line style selector
        ComboBox<String> lineStyleSelector = new ComboBox<>();

        lineStyleSelector.getItems().addAll(
            "Solid",
            "Dashed"
        );

        lineStyleSelector.setValue("Solid");
        lineStyleSelector.setPrefWidth(120);

        // color picker
        ColorPicker colorPicker = new ColorPicker();

        lineWidth.valueProperty().addListener((obs, oldValue, newValue) -> {
            lineWidthLabel.setText(
                "Line Width: " + newValue.intValue() + " px"
            );
        });

        // setup drawing area
        StackPane drawingArea = new StackPane();
        
        drawingArea.getChildren().add(selectionOverlay);

        drawingArea.getChildren().addAll(
            imageView,
            canvas
        );

        canvas.toFront();
        selectionOverlay.toFront();

        // large image support
        ScrollPane scrollPane = new ScrollPane();

        scrollPane.setContent(drawingArea);
        scrollPane.setPannable(true);

        /**
         * records the starting mouse position for drawing tools.
         * if the Color Grabber is selected, the clicked pixel color
         * is also retrieved and placed into the color picker.
         */
        canvas.setOnMousePressed(e -> {

            startX = e.getX();
            startY = e.getY();
            pencilUndoSaved = false;
            
            if (pasteMode && copiedImage != null) {

        undoRedoManager.saveUndoState(canvas);

        gc.drawImage(
            copiedImage,
            e.getX(),
            e.getY()
        );

        pasteMode = false;

        selectionOverlay.getGraphicsContext2D().clearRect(
            0,
            0,
            selectionOverlay.getWidth(),
            selectionOverlay.getHeight()
        );

        unsavedChanges = true;

        return;
    }
            
            if (toolSelector.getValue().equals("Select")) {
                selectionStartX = e.getX();
                selectionStartY = e.getY();
                selectionEndX = e.getX();
                selectionEndY = e.getY();
}

            if (toolSelector.getValue().equals("Color Grabber")) {

                WritableImage snapshot = canvas.snapshot(
                    new SnapshotParameters(),
                    null
                );

                PixelReader pixelReader = snapshot.getPixelReader();

                Color grabbedColor = pixelReader.getColor(
                    (int) e.getX(),
                    (int) e.getY()
                );

                colorPicker.setValue(grabbedColor);
            }

            // text tool
            if (toolSelector.getValue().equals("Text")) {

                TextInputDialog textDialog = new TextInputDialog();

                textDialog.setTitle("Add Text");
                textDialog.setHeaderText(
                    "Enter text to add to the image:"
                );
                textDialog.setContentText("Text:");

                Optional<String> result = textDialog.showAndWait();

                if (result.isPresent() && !result.get().isEmpty()) {

                    undoRedoManager.saveUndoState(canvas);

                    gc.setFill(colorPicker.getValue());

                    gc.fillText(
                        result.get(),
                        e.getX(),
                        e.getY()
                    );

                    unsavedChanges = true;
                }
            }
        });

        /**
         * this draws a continuous line while the user drags the mouse
         * when the Pencil tool is selected.
         */
        canvas.setOnMouseDragged(e -> {
            
            if (toolSelector.getValue().equals("Select")) {

    selectionEndX = e.getX();
    selectionEndY = e.getY();

    GraphicsContext selectionGc =
        selectionOverlay.getGraphicsContext2D();

    selectionGc.clearRect(
        0,
        0,
        selectionOverlay.getWidth(),
        selectionOverlay.getHeight()
    );

    drawSelection(
        selectionGc,
        selectionStartX,
        selectionStartY,
        selectionEndX,
        selectionEndY
    );
}
            
            
            if (toolSelector.getValue().equals("Pencil")) {

                if (!pencilUndoSaved) {

                    undoRedoManager.saveUndoState(canvas);

                    pencilUndoSaved = true;
                }

                gc.setStroke(colorPicker.getValue());

                drawingManager.drawPencil(
                    startX,
                    startY,
                    e.getX(),
                    e.getY()
                );

                startX = e.getX();
                startY = e.getY();

                unsavedChanges = true;
            }
        });

        /**
         * this draws the currently selected tool when the mouse is released.
         * This also applies the selected color, line width, and line style.
         */
        canvas.setOnMouseReleased(e -> {

            gc.setStroke(colorPicker.getValue());

            gc.setLineWidth(lineWidth.getValue());

            if (lineStyleSelector.getValue().equals("Dashed")) {
                gc.setLineDashes(30, 15);
            } else {
                gc.setLineDashes(null);
            }

            String selectedTool = toolSelector.getValue();
            
            System.out.println("Mouse released. Selected tool: " + selectedTool);

            if (!selectedTool.equals("Color Grabber")
                    && !selectedTool.equals("Pencil")
                    && !selectedTool.equals("Text")
                    && !selectedTool.equals("Select")) {

                undoRedoManager.saveUndoState(canvas);
            }

            if (selectedTool.equals("Line")) {

                gc.strokeLine(
                    startX,
                    startY,
                    e.getX(),
                    e.getY()
                );

            } else if (selectedTool.equals("Rectangle")) {

                shapeManager.drawRectangle(
                    startX,
                    startY,
                    e.getX() - startX,
                    e.getY() - startY
                );

            } else if (selectedTool.equals("Square")) {

                shapeManager.drawSquare(
                    startX,
                    startY,
                    Math.min(
                        Math.abs(e.getX() - startX),
                        Math.abs(e.getY() - startY)
                    )
                );

            } else if (selectedTool.equals("Ellipse")) {

                shapeManager.drawEllipse(
                    startX,
                    startY,
                    e.getX() - startX,
                    e.getY() - startY
                );

            } else if (selectedTool.equals("Circle")) {

                shapeManager.drawCircle(
                    startX,
                    startY,
                    Math.min(
                        Math.abs(e.getX() - startX),
                        Math.abs(e.getY() - startY)
                    )
                );

            } else if (selectedTool.equals("Triangle")) {

                shapeManager.drawTriangle(
                    startX,
                    startY,
                    e.getX(),
                    e.getY()
                );

            } else if (selectedTool.equals("Right Triangle")) {

                shapeManager.drawRightTriangle(
                    startX,
                    startY,
                    e.getX(),
                    e.getY()
                );

            } else if (selectedTool.equals("Polygon")) {
                TextInputDialog polygonDialog = new TextInputDialog("5");
                polygonDialog.setTitle("Polygon");
                polygonDialog.setHeaderText("Enter the number of sides:");
                polygonDialog.setContentText("Sides:");

                Optional<String> result = polygonDialog.showAndWait();
                if (result.isPresent()) {
                    try {
                        int sides = Integer.parseInt(result.get());
                        if (sides >= 3) {
                            polygonSides = sides;
                            double centerX = (startX + e.getX()) / 2;
                            double centerY = (startY + e.getY()) / 2;
                            double radius = Math.min(
                                Math.abs(e.getX() - startX),
                                Math.abs(e.getY() - startY)
                            ) / 2;
                            shapeManager.drawPolygon(
                                centerX, centerY, radius, polygonSides
                            );
                        } else {
                            Alert alert = new Alert(Alert.AlertType.WARNING);
                            alert.setTitle("Invalid Polygon");
                            alert.setHeaderText(null);
                            alert.setContentText(
                                "A polygon must have at least 3 sides."
                            );
                            alert.showAndWait();
                        }
                    } catch (NumberFormatException ex) {
                        Alert alert = new Alert(Alert.AlertType.WARNING);
                        alert.setTitle("Invalid Number");
                        alert.setHeaderText(null);
                        alert.setContentText("Please enter a whole number.");
                        alert.showAndWait();
                    }
                }
            } else if (selectedTool.equals("Star")) {
                TextInputDialog starDialog = new TextInputDialog("5");
                starDialog.setTitle("Star Points");
                starDialog.setHeaderText("Choose the number of star points");
                starDialog.setContentText("Points (4 or more):");

                Optional<String> result = starDialog.showAndWait();
                if (result.isPresent()) {
                    try {
                        int points = Integer.parseInt(result.get());
                        if (points >= 4) {
                            double centerX = (startX + e.getX()) / 2;
                            double centerY = (startY + e.getY()) / 2;
                            double radius = Math.min(
                                Math.abs(e.getX() - startX),
                                Math.abs(e.getY() - startY)
                            ) / 2;
                            shapeManager.drawStar(
                                centerX, centerY, radius, points
                            );
                        } else {
                            Alert alert = new Alert(Alert.AlertType.WARNING);
                            alert.setTitle("Invalid Star");
                            alert.setHeaderText(null);
                            alert.setContentText(
                                "A star must have at least 4 points."
                            );
                            alert.showAndWait();
                        }
                    } catch (NumberFormatException ex) {
                        Alert alert = new Alert(Alert.AlertType.WARNING);
                        alert.setTitle("Invalid Number");
                        alert.setHeaderText(null);
                        alert.setContentText("Please enter a whole number.");
                        alert.showAndWait();
                    }
                }
            }

            unsavedChanges = true;
        });

        //tp is now declared before menu handlers that use it.
        TabPane tabPane = new TabPane();

        /**
         * this clears the current canvas after asking the user
         * for confirmation.
         */
        clearItem.setOnAction(e -> {

            Alert alert = new Alert(Alert.AlertType.CONFIRMATION);

            alert.setTitle("Clear Canvas");
            alert.setHeaderText("Clear Canvas?");
            alert.setContentText(
                "Are you sure you want to clear the canvas?"
            );

            Optional<ButtonType> result = alert.showAndWait();

            if (result.isPresent() && result.get() == ButtonType.OK) {

                Tab selectedTab = tabPane.getSelectionModel().getSelectedItem();
                Canvas selectedCanvas = tabCanvases.get(selectedTab);
                Canvas selectedSelectionOverlay = tabSelectionOverlays.get(selectedTab);

                if (selectedCanvas != null && selectedSelectionOverlay != null) {
                    GraphicsContext selectedGc = selectedCanvas.getGraphicsContext2D();

                    undoRedoManager.saveUndoState(selectedCanvas);

                    selectedGc.clearRect(
                        0,
                        0,
                        selectedCanvas.getWidth(),
                        selectedCanvas.getHeight()
                    );

                    selectedSelectionOverlay.getGraphicsContext2D().clearRect(
                        0,
                        0,
                        selectedSelectionOverlay.getWidth(),
                        selectedSelectionOverlay.getHeight()
                    );

                    copiedImage = null;
                    pasteMode = false;

                    unsavedChanges = true;
                }
            }
        });
        /**
 * this undoes the most recent canvas change.
 */
    undoItem.setOnAction(e -> {

        Tab selectedTab = tabPane.getSelectionModel().getSelectedItem();
        Canvas selectedCanvas = tabCanvases.get(selectedTab);

        if (selectedCanvas != null) {
            undoRedoManager.undo(selectedCanvas);
            unsavedChanges = true;
        }
    });
    undoItem.setAccelerator(
    new KeyCodeCombination(KeyCode.Z, KeyCombination.CONTROL_DOWN)
);

/**
 * this redoes the most recently undone canvas change.
 */
redoItem.setOnAction(e -> {

    Tab selectedTab = tabPane.getSelectionModel().getSelectedItem();
    Canvas selectedCanvas = tabCanvases.get(selectedTab);

    if (selectedCanvas != null) {
        undoRedoManager.redo(selectedCanvas);
        unsavedChanges = true;
    }
});
copyItem.setOnAction(e -> {

    Tab selectedTab = tabPane.getSelectionModel().getSelectedItem();
    StackPane selectedDrawingArea = tabDrawingAreas.get(selectedTab);
    Canvas selectedSelectionOverlay = tabSelectionOverlays.get(selectedTab);

    if (selectedDrawingArea != null && selectedSelectionOverlay != null) {
        copiedImage = copySelection(
            selectedDrawingArea,
            selectedSelectionOverlay,
            selectionStartX,
            selectionStartY,
            selectionEndX,
            selectionEndY
        );
    }
});
pasteItem.setOnAction(e -> {

    if (copiedImage != null) {
        pasteMode = true;
    }
});
    redoItem.setAccelerator(
        new KeyCodeCombination(KeyCode.Y, KeyCombination.CONTROL_DOWN)
    );

        /**
         * opens an image selected by the user and resizes the canvas
         * to match the dimensions of the opened image.
         */
        openItem.setOnAction(e -> {

            File selectedFile = fileManager.chooseOpenFile(stage);

            if (selectedFile != null) {

                Image image = fileManager.openImage(selectedFile);

                if (image != null) {

                    Tab selectedTab = tabPane.getSelectionModel().getSelectedItem();

                    ImageView selectedImageView = tabImageViews.get(selectedTab);
                    Canvas selectedCanvas = tabCanvases.get(selectedTab);
                    Canvas selectedSelectionOverlay = tabSelectionOverlays.get(selectedTab);

                    if (selectedImageView != null && selectedCanvas != null
                            && selectedSelectionOverlay != null) {

                        selectedImageView.setImage(null);

                        selectedCanvas.setWidth(image.getWidth());
                        selectedCanvas.setHeight(image.getHeight());

                        selectedSelectionOverlay.setWidth(image.getWidth());
                        selectedSelectionOverlay.setHeight(image.getHeight());

                        GraphicsContext selectedGc = selectedCanvas.getGraphicsContext2D();
                        selectedGc.clearRect(
                            0,
                            0,
                            selectedCanvas.getWidth(),
                            selectedCanvas.getHeight()
                        );
                        selectedGc.drawImage(image, 0, 0);

                        // new image starts a redo/undo history
                        // for this tab.
                        undoRedoManager.clearHistory(selectedCanvas);

                        tabFiles.put(selectedTab, selectedFile);
                        currentFile = selectedFile;
                        unsavedChanges = false;
                    }
                }
            }
        });

        /**
         * saves the current drawing.
         * If this tab has not been saved yet, asks for a destination.
         * Otherwise, saves over the file associated with this tab.
         */
        saveItem.setOnAction(e -> {

            Tab selectedTab =
                tabPane.getSelectionModel().getSelectedItem();

            if (selectedTab == null) {
                return;
            }

            StackPane selectedDrawingArea =
                tabDrawingAreas.get(selectedTab);

            if (selectedDrawingArea == null) {
                return;
            }

            //each tab keeps track of its own
            File selectedFile = tabFiles.get(selectedTab);

            // A new/untitled drawing has no destination yet.
            if (selectedFile == null) {

                FileChooser fileChooser =
                    fileManager.createSaveFileChooser();

                selectedFile =
                    fileChooser.showSaveDialog(stage);

                // Do nothing if the user cancels the dialog.
                if (selectedFile == null) {
                    return;
                }

                String format =
                    fileManager.getFormatFromFilter(
                        fileChooser.getSelectedExtensionFilter()
                    );

                selectedFile = fileManager.ensureFileExtension(selectedFile, format);

                //added a warning if you decide to change format u will get a warning
                if (!confirmAlternativeFormat(format)) {
                    return;
                }

                boolean saved = fileManager.saveImage(
                    selectedDrawingArea,
                    selectedFile,
                    format
                );

                if (saved) {
                    tabFiles.put(selectedTab, selectedFile);
                    currentFile = selectedFile;
                    unsavedChanges = false;

                    Alert alert = new Alert(
                        Alert.AlertType.INFORMATION
                    );
                    alert.setTitle("Save");
                    alert.setHeaderText(null);
                    alert.setContentText(
                        "File saved: " + selectedFile.getName()
                    );
                    alert.showAndWait();
                }

                return;
            }

            String format =
                fileManager.getFormatFromFile(selectedFile);

            boolean saved = fileManager.saveImage(
                selectedDrawingArea,
                selectedFile,
                format
            );

            if (saved) {
                currentFile = selectedFile;
                unsavedChanges = false;

                Alert alert = new Alert(
                    Alert.AlertType.INFORMATION
                );
                alert.setTitle("Save");
                alert.setHeaderText(null);
                alert.setContentText(
                    "File saved: " + selectedFile.getName()
                );
                alert.showAndWait();
            }
        });

        /**
         * this saves the current drawing as a new image file using the
         * format selected by the user.
         */
saveAsItem.setOnAction(e -> {

    Tab selectedTab = tabPane.getSelectionModel().getSelectedItem();

    StackPane selectedDrawingArea =
        tabDrawingAreas.get(selectedTab);

    if (selectedTab != null && selectedDrawingArea != null) {

        FileChooser fileChooser =
            fileManager.createSaveFileChooser();

        File selectedFile =
            fileChooser.showSaveDialog(stage);

        if (selectedFile != null) {

            String format =
                fileManager.getFormatFromFilter(
                    fileChooser.getSelectedExtensionFilter()
                );

            selectedFile = fileManager.ensureFileExtension(selectedFile, format);

            // the warning.
            if (!confirmAlternativeFormat(format)) {
                return;
            }

            boolean saved = fileManager.saveImage(
                selectedDrawingArea,
                selectedFile,
                format
            );

            if (saved) {

                tabFiles.put(
                    selectedTab,
                    selectedFile
                );

                currentFile = selectedFile;
                unsavedChanges = false;

                Alert alert = new Alert(
                    Alert.AlertType.INFORMATION
                );

                alert.setTitle("Save");
                alert.setHeaderText(null);
                alert.setContentText(
                    "File saved: "
                    + selectedFile.getName()
                );

                alert.showAndWait();
            }
        }
    }
});

   
        // program! LETS LEAVE!
        /**
         * this closes the application window.
         */
        exitItem.setOnAction(e -> {
            stage.close();
        });

        // basically all the options inside file
        fileMenu.getItems().addAll(
            openItem,
            saveItem,
            saveAsItem,
            undoItem,
            redoItem,
            clearItem,
            copyItem,
            pasteItem,
            exitItem
        );

        /**
         * this creates the tabbed workspace used to hold multiple images.
         */
        //
        Tab firstTab = new Tab("Untitled");

        firstTab.setContent(scrollPane);

        tabPane.getTabs().add(firstTab);

        tabImageViews.put(firstTab, imageView);
        tabCanvases.put(firstTab, canvas);
        tabSelectionOverlays.put(firstTab, selectionOverlay);
        tabDrawingAreas.put(firstTab, drawingArea);

        /**
         * this creates a button for adding additional image tabs.
         */
        Button addTabButton = new Button("+");

        addTabButton.setOnAction(e -> {

            Tab newTab = new Tab("Untitled");

            ImageTab newImageTab = new ImageTab();

            Canvas newCanvas = newImageTab.getCanvas();
            GraphicsContext newGc = newImageTab.getGraphicsContext();
            Canvas newSelectionOverlay = newImageTab.getSelectionOverlay();

            ShapeManager newShapeManager = new ShapeManager(newGc);
            DrawingManager newDrawingManager = new DrawingManager(newGc);

            setupTabHandlers(
                newCanvas,
                newGc,
                newSelectionOverlay,
                newShapeManager,
                newDrawingManager,
                newImageTab.getImageView(),
                toolSelector,
                colorPicker,
                lineWidth,
                lineStyleSelector
            );

            newTab.setContent(
                newImageTab.getScrollPane()
            );

            tabPane.getTabs().add(newTab);

