        /**
         * this gives an additional ImageTab the same drawing behavior as
         * the original canvas. This keeps the tab requirement usable
         * without changing the existing drawing architecture.
         */
        private void setupTabHandlers(
                Canvas canvas,
                GraphicsContext gc,
                Canvas selectionOverlay,
                ShapeManager shapeManager,
                DrawingManager drawingManager,
                ImageView imageView,
                ComboBox<String> toolSelector,
                ColorPicker colorPicker,
                Slider lineWidth,
                ComboBox<String> lineStyleSelector) {

            canvas.setOnMousePressed(e -> {
                startX = e.getX();
                startY = e.getY();
                pencilUndoSaved = false;

                if (pasteMode && copiedImage != null) {
                    undoRedoManager.saveUndoState(canvas);
                    gc.drawImage(copiedImage, e.getX(), e.getY());
                    pasteMode = false;
                    selectionOverlay.getGraphicsContext2D().clearRect(
                        0, 0, selectionOverlay.getWidth(), selectionOverlay.getHeight()
                    );
                    unsavedChanges = true;
                    return;
                }

                if (toolSelector.getValue().equals("Select")) {
                    selectionStartX = e.getX();
                    selectionStartY = e.getY();
                    selectionEndX = e.getX();
                    selectionEndY = e.getY();
                }

                if (toolSelector.getValue().equals("Color Grabber")) {
                    WritableImage snapshot = canvas.snapshot(
                        new SnapshotParameters(), null
                    );
                    PixelReader pixelReader = snapshot.getPixelReader();
                    Color grabbedColor = pixelReader.getColor(
                        (int) e.getX(), (int) e.getY()
                    );
                    colorPicker.setValue(grabbedColor);
                }

                if (toolSelector.getValue().equals("Text")) {
                    TextInputDialog textDialog = new TextInputDialog();
                    textDialog.setTitle("Add Text");
                    textDialog.setHeaderText("Enter text to add to the image:");
                    textDialog.setContentText("Text:");

                    Optional<String> result = textDialog.showAndWait();
                    if (result.isPresent() && !result.get().isEmpty()) {
                        undoRedoManager.saveUndoState(canvas);
                        gc.setFill(colorPicker.getValue());
                        gc.fillText(result.get(), e.getX(), e.getY());
                        unsavedChanges = true;
                    }
                }
            });

            canvas.setOnMouseDragged(e -> {
                if (toolSelector.getValue().equals("Select")) {
                    selectionEndX = e.getX();
                    selectionEndY = e.getY();
                    GraphicsContext selectionGc = selectionOverlay.getGraphicsContext2D();
                    selectionGc.clearRect(
                        0, 0, selectionOverlay.getWidth(), selectionOverlay.getHeight()
                    );
                    drawSelection(
                        selectionGc,
                        selectionStartX,
                        selectionStartY,
                        selectionEndX,
                        selectionEndY
                    );
                }

                if (toolSelector.getValue().equals("Pencil")) {
                    if (!pencilUndoSaved) {
                        undoRedoManager.saveUndoState(canvas);
                        pencilUndoSaved = true;
                    }
                    gc.setStroke(colorPicker.getValue());
                    drawingManager.drawPencil(
                        startX, startY, e.getX(), e.getY()
                    );
                    startX = e.getX();
                    startY = e.getY();
                    unsavedChanges = true;
                }
            });

            canvas.setOnMouseReleased(e -> {
                gc.setStroke(colorPicker.getValue());
                gc.setLineWidth(lineWidth.getValue());

                if (lineStyleSelector.getValue().equals("Dashed")) {
                    gc.setLineDashes(30, 15);
                } else {
                    gc.setLineDashes(null);
                }

                String selectedTool = toolSelector.getValue();

                if (!selectedTool.equals("Color Grabber")
                        && !selectedTool.equals("Pencil")
                        && !selectedTool.equals("Text")
                        && !selectedTool.equals("Select")) {
                    undoRedoManager.saveUndoState(canvas);
                }

                if (selectedTool.equals("Line")) {
                    gc.strokeLine(startX, startY, e.getX(), e.getY());
                } else if (selectedTool.equals("Rectangle")) {
                    shapeManager.drawRectangle(
                        startX, startY,
                        e.getX() - startX,
                        e.getY() - startY
                    );
                } else if (selectedTool.equals("Square")) {
                    shapeManager.drawSquare(
                        startX, startY,
                        Math.min(
                            Math.abs(e.getX() - startX),
                            Math.abs(e.getY() - startY)
                        )
                    );
                } else if (selectedTool.equals("Ellipse")) {
                    shapeManager.drawEllipse(
                        startX, startY,
                        e.getX() - startX,
                        e.getY() - startY
                    );
                } else if (selectedTool.equals("Circle")) {
                    shapeManager.drawCircle(
                        startX, startY,
                        Math.min(
                            Math.abs(e.getX() - startX),
                            Math.abs(e.getY() - startY)
                        )
                    );
                } else if (selectedTool.equals("Triangle")) {
                    shapeManager.drawTriangle(
                        startX, startY, e.getX(), e.getY()
                    );
                } else if (selectedTool.equals("Right Triangle")) {
                    shapeManager.drawRightTriangle(
                        startX, startY, e.getX(), e.getY()
                    );
                } else if (selectedTool.equals("Polygon")) {
                    TextInputDialog polygonDialog = new TextInputDialog("5");
                    polygonDialog.setTitle("Polygon");
                    polygonDialog.setHeaderText("Enter the number of sides:");
                    polygonDialog.setContentText("Sides:");

                    Optional<String> result = polygonDialog.showAndWait();
                    if (result.isPresent()) {
                        try {
                            int sides = Integer.parseInt(result.get());
                            if (sides >= 3) {
                                polygonSides = sides;
                                double centerX = (startX + e.getX()) / 2;
                                double centerY = (startY + e.getY()) / 2;
                                double radius = Math.min(
                                    Math.abs(e.getX() - startX),
                                    Math.abs(e.getY() - startY)
                                ) / 2;
                                shapeManager.drawPolygon(
                                    centerX, centerY, radius, polygonSides
                                );
                            } else {
                                Alert alert = new Alert(Alert.AlertType.WARNING);
                                alert.setTitle("Invalid Polygon");
                                alert.setHeaderText(null);
                                alert.setContentText(
                                    "A polygon must have at least 3 sides."
                                );
                                alert.showAndWait();
                            }
                        } catch (NumberFormatException ex) {
                            Alert alert = new Alert(Alert.AlertType.WARNING);
                            alert.setTitle("Invalid Number");
                            alert.setHeaderText(null);
                            alert.setContentText(
                                "Please enter a whole number."
                            );
                            alert.showAndWait();
                        }
                    }
                } else if (selectedTool.equals("Star")) {
                    TextInputDialog starDialog = new TextInputDialog("5");
                    starDialog.setTitle("Star Points");
                    starDialog.setHeaderText("Choose the number of star points");
                    starDialog.setContentText("Points (4 or more):");

                    Optional<String> result = starDialog.showAndWait();
                    if (result.isPresent()) {
                        try {
                            int points = Integer.parseInt(result.get());
                            if (points >= 4) {
                                double centerX = (startX + e.getX()) / 2;
                                double centerY = (startY + e.getY()) / 2;
                                double radius = Math.min(
                                    Math.abs(e.getX() - startX),
                                    Math.abs(e.getY() - startY)
                                ) / 2;
                                shapeManager.drawStar(
                                    centerX, centerY, radius, points
                                );
                            } else {
                                Alert alert = new Alert(Alert.AlertType.WARNING);
                                alert.setTitle("Invalid Star");
                                alert.setHeaderText(null);
                                alert.setContentText(
                                    "A star must have at least 4 points."
                                );
                                alert.showAndWait();
                            }
                        } catch (NumberFormatException ex) {
                            Alert alert = new Alert(Alert.AlertType.WARNING);
                            alert.setTitle("Invalid Number");
                            alert.setHeaderText(null);
                            alert.setContentText("Please enter a whole number.");
                            alert.showAndWait();
                        }
                    }
                }

                unsavedChanges = true;
            });
        }

