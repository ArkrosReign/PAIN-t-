
package com.mycompany.mavenproject1;

import javafx.scene.SnapshotParameters;
import javafx.scene.canvas.Canvas;
import javafx.scene.canvas.GraphicsContext;
import javafx.scene.image.WritableImage;
import javafx.scene.paint.Color;

import java.util.HashMap;
import java.util.Map;
import java.util.Stack;

public class UndoRedoManager {

    private static class CanvasState {
        private final WritableImage image;
        private final double width;
        private final double height;

        private CanvasState(WritableImage image, double width, double height) {
            this.image = image;
            this.width = width;
            this.height = height;
        }
    }

    private final Map<Canvas, Stack<CanvasState>> undoStacks =
        new HashMap<>();

    private final Map<Canvas, Stack<CanvasState>> redoStacks =
        new HashMap<>();

    private Stack<CanvasState> getUndoStack(Canvas canvas) {
        return undoStacks.computeIfAbsent(canvas, key -> new Stack<>());
    }

    private Stack<CanvasState> getRedoStack(Canvas canvas) {
        return redoStacks.computeIfAbsent(canvas, key -> new Stack<>());
    }

    private CanvasState captureState(Canvas canvas) {
        double width = canvas.getWidth();
        double height = canvas.getHeight();

        if (width <= 0 || height <= 0) {
            return null;
        }

        int imageWidth = (int) Math.ceil(width);
        int imageHeight = (int) Math.ceil(height);

        WritableImage snapshot = new WritableImage(imageWidth, imageHeight);

        SnapshotParameters parameters = new SnapshotParameters();
        parameters.setFill(Color.TRANSPARENT);

        canvas.snapshot(parameters, snapshot);

        return new CanvasState(snapshot, width, height);
    }

    private void restoreState(Canvas canvas, CanvasState state) {
        if (state == null) {
            return;
        }

        canvas.setWidth(state.width);
        canvas.setHeight(state.height);

        GraphicsContext gc = canvas.getGraphicsContext2D();
        gc.clearRect(0, 0, canvas.getWidth(), canvas.getHeight());
        gc.drawImage(state.image, 0, 0);
    }

    public void saveUndoState(Canvas canvas) {
        CanvasState state = captureState(canvas);

        if (state != null) {
            getUndoStack(canvas).push(state);
            getRedoStack(canvas).clear();
        }
    }

    public void undo(Canvas canvas) {
        Stack<CanvasState> undoStack = getUndoStack(canvas);
        Stack<CanvasState> redoStack = getRedoStack(canvas);

        if (undoStack.isEmpty()) {
            return;
        }

        CanvasState currentState = captureState(canvas);

        if (currentState == null) {
            return;
        }

        redoStack.push(currentState);
        CanvasState previousState = undoStack.pop();

        restoreState(canvas, previousState);
    }

    public void redo(Canvas canvas) {
        Stack<CanvasState> undoStack = getUndoStack(canvas);
        Stack<CanvasState> redoStack = getRedoStack(canvas);

        if (redoStack.isEmpty()) {
            return;
        }

        CanvasState currentState = captureState(canvas);

        if (currentState == null) {
            return;
        }

        undoStack.push(currentState);
        CanvasState nextState = redoStack.pop();

        restoreState(canvas, nextState);
    }

    public void clearHistory(Canvas canvas) {
        getUndoStack(canvas).clear();
        getRedoStack(canvas).clear();
    }
}
